# Every variable this app reads. All are optional: the defaults run the whole
# boilerplate on MSW with no backend present.

# Where data comes from: "mock" (default) or "server".
#
# One switch rather than three. Setting the dashboard, the topology, and the
# chat separately was three ways to end up half-connected — the dashboard on the
# server while chat still answered from a mock, which looks like a working app.
#
# A production build refuses to start on "mock": a shipped bundle serving
# fabricated data looks healthy, which is the worst way to be wrong.
# VITE_DATA_MODE=server

# Per-module overrides, each "mock" or "server". Unset means "whatever
# VITE_DATA_MODE says". They exist for working on one module against the real
# server while the rest stay mocked; they are not meant to be set in a deploy.
# VITE_DASHBOARD_REPOSITORY=server
# VITE_TOPOLOGY_SOURCE=server
# VITE_CHAT_SOURCE=server

# Where the dev server proxies /api. Only used by `npm run dev`; the production
# image proxies through Caddy instead, using BACKEND_ORIGIN.
# VITE_API_TARGET=http://127.0.0.1:3001

# Set to "true" to emit the bundle treemap during `npm run build`.
# ANALYZE=true
