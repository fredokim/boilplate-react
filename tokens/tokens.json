{
  "$description": "세 보일러플레이트의 디자인 토큰 단일 소스. 형식은 W3C Design Tokens Community Group 초안을 따른다. 생성물을 직접 고치지 말고 이 파일을 고친 뒤 npm run tokens:build 를 실행한다.",
  "primitive": {
    "$description": "역할이 같은 값만 여기에 둔다. 값이 우연히 같다는 이유로 묶지 않는다. 예를 들어 ds.radius.sm과 ds.spacing.1은 둘 다 0.25rem이지만 서로 다른 결정이며, 묶으면 간격을 바꿀 때 모서리 반경이 따라 바뀐다.",
    "color": {
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "패널 배경과 중립색 0단계가 같은 흰색을 쓴다."
      },
      "slate50": {
        "$value": "#f8fafc",
        "$type": "color",
        "$description": "밝은 표면. web.color.surface와 ds.colorNeutral.50이 같은 역할이다."
      },
      "violet": {
        "$value": "#6c5dd3",
        "$type": "color",
        "$description": "라이트와 다크가 같은 보조색을 쓴다."
      },
      "coral": {
        "$value": "#ff7f5c",
        "$type": "color",
        "$description": "라이트와 다크가 같은 강조색을 쓴다."
      }
    }
  },
