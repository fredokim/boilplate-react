{
  "name": "react-boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,scripts,.storybook}/**/*.{ts,tsx,js}\" --max-warnings=0",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6007",
    "build-storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "e2e": "playwright test",
    "check:ai": "tsx scripts/check-ai-workflow.ts",
    "check:automation": "tsx scripts/check-automation.ts",
    "check:generators": "tsx scripts/check-generators.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:deps": "tsx scripts/check-dependency-size.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:ci": "npm run check:tokens && npm run lint && npm run typecheck && npm run test && npm run check:ai && npm run check:automation && npm run check:generators && npm run check:deps && npm run build && npm run check:bundle && npm run build-storybook",
    "perf:bundle": "cross-env ANALYZE=true npm run build",
    "generate": "tsx scripts/generate.ts",
    "generate:contract": "tsx scripts/generate-contract.ts",
    "generate:form": "tsx scripts/generate-form.ts",
    "generate:layout": "tsx scripts/generate-layout.ts",
    "generate:page": "tsx scripts/generate-page.ts",
    "generate:feature": "tsx scripts/generate-feature.ts",
    "check:all": "npm run check:ci && npm run check:contract",
    "check:contract": "vitest run src/test/contract",
    "dev:server-mode": "cross-env VITE_DATA_MODE=server npm run dev",
    "contract:sync": "node -e \"require('node:fs').copyFileSync(process.env.SERVER_REPO ? process.env.SERVER_REPO + '/openapi.json' : '../boilplate-server/openapi.json', 'contracts/openapi.json')\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8.5.15",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.100.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.14.9",
    "@visx/xychart": "^4.0.0",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "hls.js": "^1.7.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-grid-layout": "^2.2.4",
    "react-router-dom": "^7.15.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
