# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
storybook-static
test-results
playwright-report
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Reports produced by the coverage and Lighthouse gates. Regenerated on every
# run, and a checked-in copy only ever disagrees with the current one.
coverage/
.lighthouseci/
reports/

# Real values never enter the repository; only .env.example is tracked. `*.local`
# above covers Vite's .env.local and nothing else — .env is what `.env.example`
# tells a reader to create, and it is where a secret ends up the first time one
# is needed.
.env
.env.*
!.env.example
